msgstr "ลบสถิติทั้งหมด..."

msgid "{period}: no uses recorded. Recording since {date}."
msgstr "{period}: ยังไม่มีการใช้งาน บันทึกตั้งแต่ {date}"

msgid "&Start testing gestures"
msgstr "เริ่มทดสอบปุ่มลัด"

