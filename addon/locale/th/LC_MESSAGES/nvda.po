msgid "{n} depend on focus"
msgstr "ขึ้นอยู่กับตำแหน่งโฟกัส {n} รายการ"

msgid "Remove {key}"
msgstr "ลบ {key}"

msgid "Could not assign {g}. {old} was kept. Details are in the NVDA log."
msgstr "ไม่สามารถกำหนด {g} ได้ จึงคงปุ่มลัด {old} ไว้ตามเดิม ดูรายละเอียดใน NVDA log"

msgid "Remove {g} from {cmd}?"
msgstr "ต้องการลบ {g} ออกจาก {cmd} หรือไม่"

