msgstr "ส่วนเสริม {n} ตัว ทำงานอยู่ {running} ตัว"

msgid "Change {key}, also used by {cmds}..."
msgstr "เปลี่ยน {key} ซึ่งใช้ร่วมกับ {cmds}..."

msgid "Change {key}..."
msgstr "เปลี่ยน {key}..."

msgid "{key}, also used by {cmds}"
msgstr "{key}, ใช้ร่วมกับ {cmds}"

msgid "Reset all commands of {owner} to default..."
msgstr "คืนค่าปุ่มลัดเริ่มต้นทุกคำสั่งของ {owner}..."

msgid "{addon}: commands reset to default: {n}"
msgstr "{addon}: คืนค่าปุ่มลัดเริ่มต้นแล้ว {n} คำสั่ง"

msgid "Reset to default. Gestures now: {keys}"
msgstr "คืนค่าแล้ว ปุ่มลัดตอนนี้: {keys}"

msgid "It is already used by {cmds}."
msgstr "ปุ่มนี้ถูกใช้โดย {cmds}"

msgid "{g} is already assigned to this command"
msgstr "{g} ถูกกำหนดให้คำสั่งนี้อยู่แล้ว"

msgid "Keep on both commands: {winner} will still run; {cmd} will not run with this key."
msgstr "คงไว้ทั้งสองคำสั่ง: {winner} ยังคงทำงาน ส่วน {cmd} จะใช้ปุ่มนี้ไม่ได้"

msgid "{cmds} and {cmd} are in the same group of commands, where NVDA gives a key to only one command: if you keep it, it is still moved from {cmds}."
msgstr "{cmds} และ {cmd} อยู่ในกลุ่มคำสั่งเดียวกัน ซึ่ง NVDA ให้ปุ่มหนึ่งปุ่มกับคำสั่งเดียวเท่านั้น หากเลือกใช้ทั้งสองคำสั่ง ปุ่มนี้จะยังถูกย้ายออกจาก {cmds}"

msgid "Could not assign {g}. No changes were made. Details are in the NVDA log."
msgstr "ไม่สามารถกำหนด {g} ได้ จึงไม่มีการเปลี่ยนแปลงใด ดูรายละเอียดใน NVDA log"

msgid "Could not fully apply {g} ({cmds}). Details are in the NVDA log."
msgstr "ไม่สามารถกำหนด {g} ได้ครบถ้วน ({cmds}) ดูรายละเอียดใน NVDA log"

msgid "Moved {g} to {cmd}"
